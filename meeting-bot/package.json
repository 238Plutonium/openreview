{
  "name": "echo-ai-naacl-submission",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "build:bot": "mkdir -p dist/public && esbuild src/bot.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=dist/public/bot.js",
    "copy:static": "cp public/bot.html public/echo-avatar.svg public/echo-avatar.png dist/public/",
    "build": "umask 002 && npm run clean && tsc -p tsconfig.json && npm run build:bot && npm run copy:static",
    "start": "node dist/server.js",
    "demo:replay": "node scripts/demo_replay.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@types/jpeg-js": "^0.3.0",
    "@zoom/meetingsdk": "4.0.7",
    "@zoom/rtms": "^1.1.0",
    "cors": "2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.9.3",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "9.0.2",
    "playwright": "1.58.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
